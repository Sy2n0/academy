{
  "name": "saas-starter-kit",
  "version": "1.6.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "prisma": {
    "seed": "ts-node ./prisma/seed.ts"
  },
  "scripts": {
    "prepare": "husky",
    "release": "git checkout release && git merge origin/main && release-it && git checkout main && git merge origin/release && git push origin main",
    "dev": "next dev -H 0.0.0.0 --port 4003",
    "build": "prisma generate && prisma db push && next build",
    "start": "next start --port 4002",
    "check-types": "tsc --pretty --noEmit",
    "check-format": "prettier --check .",
    "check-lint": "eslint -c eslint.config.cjs ./",
    "check-unused": "npx knip",
    "format": "prettier --write .",
    "test-all": "pnpm check-format && pnpm check-lint && pnpm check-types && pnpm build",
    "playwright:update": "playwright install && playwright install-deps",
    "test:e2e": "playwright test -x",
    "test": "jest",
    "test:unit": "jest --testPathPatterns='__tests__/lib'",
    "test:integration": "jest --testPathPatterns='__tests__/api'",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --env=jsdom",
    "build-ci": "next build",
    "sandbox:pull-c-image": "bash scripts/pull-playground-c-sandbox.sh",
    "sync-stripe": "node --env-file .env sync-stripe.js",
    "check-locale": "node check-locale.js",
    "delete-team": "node --env-file .env delete-team.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@boxyhq/metrics": "0.3.0",
    "@boxyhq/react-ui": "3.6.0",
    "@boxyhq/saml-jackson": "1.52.2",
    "@heroicons/react": "2.2.0",
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.1",
    "@retracedhq/logs-viewer": "2.10.1",
    "@retracedhq/retraced": "0.7.23",
    "@sentry/nextjs": "10.75.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/ioredis": "^4.28.10",
    "@vercel/analytics": "^1.6.1",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "^0.7.1",
    "classnames": "2.5.1",
    "clsx": "^2.1.1",
    "cookies-next": "6.1.1",
    "currency-symbol-map": "5.1.0",
    "dockerode": "^4.0.9",
    "dotenv": "^17.4.2",
    "formidable": "^3.5.4",
    "formik": "2.4.9",
    "framer-motion": "^12.29.2",
    "gsap": "^3.15.0",
    "highlight.js": "^11.12.0",
    "html2canvas": "^1.4.1",
    "i18next": "25.7.2",
    "ioredis": "^5.9.2",
    "jose": "^5.4.0",
    "lenis": "^1.3.27",
    "lucide-react": "^0.563.0",
    "micromatch": "4.0.8",
    "mixpanel-browser": "2.84.0",
    "next": "^15.5.21",
    "next-auth": "4.24.15",
    "next-i18next": "15.4.3",
    "nodemailer": "7.0.11",
    "openid-client": "^5.6.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-email": "5.0.8",
    "react-google-recaptcha": "3.1.0",
    "react-hot-toast": "2.6.1",
    "react-i18next": "15.5.3",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-directive": "^4.0.0",
    "remark-directive-rehype": "^0.4.2",
    "remark-gfm": "^4.0.1",
    "sharp": "0.35.5",
    "slack-notify": "2.0.7",
    "socket.io": "^4.8.4",
    "stripe": "17.7.0",
    "svix": "1.99.1",
    "swr": "2.5.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "yup": "1.7.1",
    "zod": "3.25.64"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "6.9.1",
    "@types/formidable": "^3.5.1",
    "@types/jest": "30.0.0",
    "@types/micromatch": "4.0.10",
    "@types/mixpanel-browser": "2.66.0",
    "@types/node": "25.9.3",
    "@types/nodemailer": "7.0.4",
    "@types/react": "18.3.13",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "autoprefixer": "10.6.2",
    "eslint": "9.39.2",
    "eslint-config-next": "15.5.9",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-i18next": "6.1.5",
    "husky": "^9.1.7",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "lint-staged": "^17.6.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.1",
    "release-it": "19.1.0",
    "tailwindcss": "^3.4.19",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "typeorm": {
      "mssql": ">=11.0.0"
    },
    "react-email": {
      "esbuild": ">=0.25.0",
      "next": ">=15.2.3"
    },
    "@react-email/components": {
      "prismjs": ">=1.30.0"
    }
  }
}
