# Database
DATABASE_URL=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# App URL
APP_URL=

# Discord Bot
DISCORD_BOT_API_URL=
# MinIO / S3 Storage Configuration
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=

# Local Storage (fallback if S3 not available)
LOCAL_STORAGE_DIR=./storage

# Redis Cache Configuration
REDIS_URL=

# Cloudflare Turnstile
CLOUDFLARE_TURNSTILE_SECRET_KEY=
CLOUDFLARE_TURNSTILE_SITE_KEY=
S3_PUBLIC_ENDPOINT=

# CI/CD test result reporting
PLATFORM_API_KEY=

# Web terminal for learning modules. Must serve a web terminal (ttyd) on
# LEARN_TERMINAL_CONTAINER_PORT (the port inside the container — the host
# port is picked per session from 20000-30000). Attack Box uses 8080; ttyd 7681.
LEARN_TERMINAL_IMAGE=
LEARN_TERMINAL_CONTAINER_PORT=8080

# ── OpenVPN ────────────────────────────────────────────────────────────────
# Machines are reachable only from inside the tunnel. Leave VPN_REQUIRED unset
# until the openvpn service is actually running, or every machine start will be
# refused with no way to satisfy the check.
VPN_REQUIRED=
# Docker network the machine containers join. Unset keeps the old behaviour of
# publishing to the host.
MACHINE_NETWORK=hub-machines
# Container the certificate commands run in.
OPENVPN_CONTAINER=hub-academy-openvpn-1
# Where the connect/disconnect hooks reach this app from inside the VPN
# container. Shares PLATFORM_API_KEY with the CI test reporter.
VPN_PLATFORM_URL=http://host.docker.internal:4003
# The one range pushed to VPN clients. Must match the machines network subnet in
# docker-compose.yml. Generate the server with `ovpn_genconfig -d` so it pushes
# no default gateway — otherwise the whole client internet routes through here.
VPN_ROUTED_SUBNET=10.10.10.0/24
# How often vpn-sync reports the live client list, in seconds. Must stay well
# under lib/vpn.ts VPN_STALE_AFTER_MS (5 min) or connected users age out.
VPN_SYNC_INTERVAL=60
# Countries allowed to open a tunnel, space separated (ISO codes, lowercase).
# A profile shared with someone abroad stops working; the account is untouched.
# Note this also locks out a student who is genuinely travelling.
VPN_ALLOWED_COUNTRIES=kr
# Whether a missing country list denies everyone. Default false: a failed
# download should not take the platform down. The hook logs when it skips.
VPN_GEO_FAIL_CLOSED=false
